# ── Stock Analysis Platform — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values. NEVER commit .env to git.
#
#   cp .env.example .env

# ── Polygon.io (stock market data) ────────────────────────────────────────────
# Free tier: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# ── FRED (Federal Reserve Economic Data) ──────────────────────────────────────
# Free tier: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ── PostgreSQL connection ──────────────────────────────────────────────────────
# docker-compose sets this automatically for local dev.
DATABASE_URL=postgres://stockapp:stockapp@localhost:5432/stockapp?sslmode=disable

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_RPM=60
RATE_LIMIT_WINDOW=60s
